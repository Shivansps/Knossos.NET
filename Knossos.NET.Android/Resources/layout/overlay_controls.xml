<?xml version="1.0" encoding="utf-8"?>
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/overlay_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clickable="false"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:focusable="false"
    android:layoutDirection="ltr"
    android:splitMotionEvents="true">

    <LinearLayout
        android:id="@+id/topBar"
        android:layout_width="match_parent"
        android:layout_height="32dp"
        android:layout_gravity="top"
        android:clipChildren="false"
        android:gravity="top"
        android:orientation="horizontal">

        <HorizontalScrollView
            android:id="@+id/topBarLeftScroller"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:fillViewport="true"
            android:overScrollMode="never"
            android:scrollbars="none">

            <LinearLayout
                android:id="@+id/topBarLeft"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:gravity="end|top"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btn0"
                    style="@style/Widget.KnossosNET.HudButton"
                    android:text="0" />

                <Button
                    android:id="@+id/btnF1"
                    style="@style/Widget.KnossosNET.HudButton"
                    android:text="F1" />

                <Button
                    android:id="@+id/btnF2"
                    style="@style/Widget.KnossosNET.HudButton"
                    android:text="F2" />

                <Button
                    android:id="@+id/btnF3"
                    style="@style/Widget.KnossosNET.HudButton"
                    android:text="F3" />

                <Button
                    android:id="@+id/btnF4"
                    style="@style/Widget.KnossosNET.HudButton"
                    android:text="F4" />

                <Button
                    android:id="@+id/btnEsc"
                    style="@style/Widget.KnossosNET.HudButton"
                    android:minWidth="52dp"
                    android:text="ESC" />
            </LinearLayout>
        </HorizontalScrollView>

        <Button
            android:id="@+id/btnToggle"
            style="@style/Widget.KnossosNET.HudButton"
            android:contentDescription="Show or hide touch control groups"
            android:minWidth="38dp"
            android:text="≡"
            android:textSize="18sp" />

        <HorizontalScrollView
            android:id="@+id/topBarRightScroller"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:fillViewport="true"
            android:overScrollMode="never"
            android:scrollbars="none">

            <LinearLayout
                android:id="@+id/topBarRight"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:gravity="start|top"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btnKyb"
                    style="@style/Widget.KnossosNET.HudButton"
                    android:minWidth="56dp"
                    android:text="KEYB" />

                <Button
                    android:id="@+id/btnAltJ"
                    style="@style/Widget.KnossosNET.HudButton"
                    android:text="ALT+J" />

                <Button
                    android:id="@+id/btnAltM"
                    style="@style/Widget.KnossosNET.HudButton"
                    android:text="ALT-M" />

                <Button
                    android:id="@+id/btnAltH"
                    style="@style/Widget.KnossosNET.HudButton"
                    android:text="ALT-H" />

                <Button
                    android:id="@+id/btnAltA"
                    style="@style/Widget.KnossosNET.HudButton"
                    android:text="ALT-A" />
            </LinearLayout>
        </HorizontalScrollView>
    </LinearLayout>

    <com.knossosnet.knossosnet.overlay.RadialActionView
        android:id="@+id/communicationWheel"
        android:layout_width="1dp"
        android:layout_height="1dp"
        android:layout_gravity="top|start"
        android:contentDescription="Communication controls" />

    <com.knossosnet.knossosnet.overlay.RadialActionView
        android:id="@+id/targetWheel"
        android:layout_width="1dp"
        android:layout_height="1dp"
        android:layout_gravity="top|start"
        android:contentDescription="Targeting controls" />

    <com.knossosnet.knossosnet.overlay.RadialDpadView
        android:id="@+id/dpad"
        android:layout_width="1dp"
        android:layout_height="1dp"
        android:layout_gravity="top|start"
        android:clickable="true"
        android:contentDescription="Direction control with TAB outer ring"
        android:focusable="false" />

    <com.knossosnet.knossosnet.overlay.RadialActionView
        android:id="@+id/weaponWheel"
        android:layout_width="1dp"
        android:layout_height="1dp"
        android:layout_gravity="top|start"
        android:contentDescription="Weapon and ship controls" />

</FrameLayout>
