<UserControl xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:views="using:Knossos.NET.Views" xmlns:vm="using:Knossos.NET.ViewModels" xmlns:c="using:Knossos.NET.Controls"
    xmlns:html="clr-namespace:TheArtOfDev.HtmlRenderer.Avalonia;assembly=Avalonia.HtmlRenderer"
    x:Class="Knossos.NET.Views.ModInformationView" x:DataType="vm:ModInformationViewModel"
    mc:Ignorable="d" d:DesignWidth="1200" d:DesignHeight="860">
  <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
    <StackPanel x:Name="InformationLayout" Margin="24,20" Spacing="14">
      <StackPanel Spacing="4">
        <TextBlock Classes="heading" Text="{Binding Name}"/>
        <TextBlock Classes="muted" Text="{Binding Subtitle}" FontSize="16" TextWrapping="Wrap"/>
      </StackPanel>
      <Border x:Name="BannerFrame" Classes="surface" Height="230" ClipToBounds="True">
        <Grid>
          <Border IsVisible="{Binding !HasBanner}" Background="{DynamicResource FuturisticSelection}">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="16" Spacing="8">
              <PathIcon Data="{StaticResource FuturisticInfoIcon}" Width="32" Height="32" Foreground="#79B6EE"/>
              <TextBlock Text="FREESPACE OPEN" FontSize="20" FontWeight="SemiBold" TextWrapping="Wrap" TextAlignment="Center"/>
            </StackPanel>
          </Border>
          <c:AnimatedImage Path="{Binding Banner}" IsVisible="{Binding HasBanner}" Stretch="UniformToFill" Playing="{Binding !Properties.IsModalOpen}"/>
        </Grid>
      </Border>
      <WrapPanel IsVisible="{Binding Properties.IsInstalled}">
        <Button Classes="play" Command="{Binding LaunchCommand}" CommandParameter="Release" IsEnabled="{Binding CanLaunch}" Margin="0,0,8,8" ToolTip.Tip="Launch Play"><StackPanel Orientation="Horizontal" Spacing="10"><PathIcon Data="{StaticResource FuturisticPlayIcon}"/><TextBlock Text="Play" VerticalAlignment="Center"/></StackPanel></Button>
<Button Classes="debug" Command="{Binding LaunchCommand}" CommandParameter="Debug" IsEnabled="{Binding CanLaunch}" Margin="0,0,8,8" ToolTip.Tip="Launch Debug"><StackPanel Orientation="Horizontal" Spacing="10"><PathIcon Data="{StaticResource FuturisticBugIcon}"/><TextBlock Text="Debug" VerticalAlignment="Center"/></StackPanel></Button>
<Button Classes="editor" Command="{Binding LaunchCommand}" CommandParameter="Fred2" IsEnabled="{Binding CanUseEditors}" Margin="0,0,8,8" ToolTip.Tip="Launch Fred2"><StackPanel Orientation="Horizontal" Spacing="10"><PathIcon Data="{StaticResource FuturisticToolIcon}"/><TextBlock Text="Fred2" VerticalAlignment="Center"/></StackPanel></Button>
<Button Classes="editor" Command="{Binding LaunchCommand}" CommandParameter="Fred2Debug" IsEnabled="{Binding CanUseEditors}" Margin="0,0,8,8" ToolTip.Tip="Launch Fred2 Debug"><StackPanel Orientation="Horizontal" Spacing="10"><PathIcon Data="{StaticResource FuturisticBugIcon}"/><TextBlock Text="Fred2 Debug" VerticalAlignment="Center"/></StackPanel></Button>
<Button Classes="" Command="{Binding LaunchCommand}" CommandParameter="QtFred" IsEnabled="{Binding IsQtFredAvailable}" Margin="0,0,8,8" ToolTip.Tip="Launch QtFred"><StackPanel Orientation="Horizontal" Spacing="10"><PathIcon Data="{StaticResource FuturisticToolIcon}"/><TextBlock Text="QtFred" VerticalAlignment="Center"/></StackPanel></Button>
<Button Classes="" Command="{Binding LaunchCommand}" CommandParameter="QtFredDebug" IsEnabled="{Binding IsQtFredDebugAvailable}" Margin="0,0,8,8" ToolTip.Tip="Launch QtFred Debug"><StackPanel Orientation="Horizontal" Spacing="10"><PathIcon Data="{StaticResource FuturisticBugIcon}"/><TextBlock Text="QtFred Debug" VerticalAlignment="Center"/></StackPanel></Button>
        <Button Classes="accent" Command="{Binding Properties.NavigateCommand}" CommandParameter="{x:Static vm:ModPropertiesViewModel+MenuPageEntry.Options}" IsEnabled="{Binding Properties.CanConfigure}" Margin="0,0,8,8">
          <StackPanel Orientation="Horizontal" Spacing="10"><PathIcon Data="{StaticResource FuturisticSettingsIcon}"/><TextBlock Text="Settings" VerticalAlignment="Center"/></StackPanel>
        </Button>
        <Button IsVisible="{Binding CanReport}" Command="{Binding Properties.ReportCommand}" Margin="0,0,8,8">
          <StackPanel Orientation="Horizontal" Spacing="10"><PathIcon Data="{StaticResource FuturisticFlagIcon}"/><TextBlock Text="Report" VerticalAlignment="Center"/></StackPanel>
        </Button>
        <Button Classes="danger" IsVisible="{Binding CanDelete}" Command="{Binding Properties.DeleteCommand}" Margin="0,0,8,8">
          <StackPanel Orientation="Horizontal" Spacing="10"><PathIcon Data="{StaticResource FuturisticDeleteIcon}"/><TextBlock Text="Delete" VerticalAlignment="Center"/></StackPanel>
        </Button>
      </WrapPanel>
      <Border Classes="surface" Padding="12,10">
        <WrapPanel x:Name="MetadataPanel" ItemWidth="215">
          <StackPanel Margin="0,0,16,6" Spacing="4">
            <TextBlock Text="Version" Classes="muted"/>
            <ComboBox ItemsSource="{Binding Properties.VersionItems}" SelectedIndex="{Binding Properties.SelectedVersionIndex, Mode=TwoWay}" HorizontalAlignment="Stretch" AutomationProperties.Name="Mod version"/>
          </StackPanel>
          <StackPanel Margin="0,0,16,6" Spacing="8">
            <TextBlock Text="Released" Classes="muted"/>
            <TextBlock Text="{Binding Released}" FontSize="16"/>
          </StackPanel>
          <StackPanel Margin="0,0,16,6" Spacing="8">
            <TextBlock Text="Last Updated" Classes="muted"/>
            <TextBlock Text="{Binding LastUpdated}" FontSize="16"/>
          </StackPanel>
          <StackPanel Margin="0,0,0,6" Spacing="8">
            <TextBlock Text="Owners" Classes="muted"/>
            <TextBlock Text="{Binding Owners}" TextWrapping="Wrap"/>
          </StackPanel>
        </WrapPanel>
      </Border>
      <ProgressBar IsVisible="{Binding IsLoading}" IsIndeterminate="True" Height="3"/>
      <Border Classes="surface" Padding="12" IsVisible="{Binding HasLoadError}">
        <StackPanel Spacing="8">
          <TextBlock Text="{Binding LoadError}" TextWrapping="Wrap" Foreground="#FFC78A"/>
          <Button Content="Retry" Command="{Binding RetryLoadCommand}"/>
        </StackPanel>
      </Border>
      <Grid x:Name="DetailsLayout" ColumnDefinitions="*,360" RowDefinitions="Auto,Auto">
        <StackPanel x:Name="DescriptionPanel" Margin="0,0,24,0" Spacing="14">
          <Border Height="1" Background="{DynamicResource FuturisticBorder}"/>
          <html:HtmlPanel Text="{Binding Description}" Background="Transparent" HorizontalAlignment="Stretch"/>
          <Button Content="Visit release thread ↗" Command="{Binding ForumCommand}" IsVisible="{Binding ForumAvailable}"/>
        </StackPanel>
        <Border x:Name="GalleryPanel" Grid.Column="1" Classes="surface" Padding="12" VerticalAlignment="Top">
          <StackPanel Spacing="12">
            <Grid ColumnDefinitions="*,*">
              <Button Classes="mediaTab" Classes.selected="{Binding !ShowVideos}" Command="{Binding SelectMediaTabCommand}" CommandParameter="screenshots" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Padding="4,10">
                <TextBlock Text="{Binding ScreenshotTab}" TextWrapping="Wrap" TextAlignment="Center"/>
              </Button>
              <Button Grid.Column="1" Classes="mediaTab" Classes.selected="{Binding ShowVideos}" Command="{Binding SelectMediaTabCommand}" CommandParameter="videos" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Padding="4,10">
                <TextBlock Text="{Binding VideoTab}" TextWrapping="Wrap" TextAlignment="Center"/>
              </Button>
            </Grid>
            <ItemsControl x:Name="MediaGrid" ItemsSource="{Binding VisibleMedia}">
              <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:ModMediaItemViewModel">
                  <Button Classes="thumbnail" Width="{Binding $parent[views:ModInformationView].ThumbnailWidth}" Height="{Binding $parent[views:ModInformationView].ThumbnailHeight}" Margin="0,0,8,8" Command="{Binding OpenCommand}" IsEnabled="{Binding !IsLoading}" ToolTip.Tip="{Binding Title}" AutomationProperties.Name="{Binding Title}">
                    <Grid>
                      <c:AnimatedImage Path="{Binding ImagePath}" Stretch="UniformToFill" Playing="False"/>
                      <TextBlock Text="Image unavailable" IsVisible="{Binding Unavailable}" TextWrapping="Wrap" TextAlignment="Center" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="8"/>
                      <ProgressBar IsIndeterminate="True" IsVisible="{Binding IsLoading}" Height="3" VerticalAlignment="Bottom"/>
                      <Border Background="#B509111A" CornerRadius="4" Padding="6" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="6">
                        <Panel>
                          <PathIcon Data="{StaticResource FuturisticZoomIcon}" IsVisible="{Binding !IsVideo}" Width="18" Height="18"/>
                          <PathIcon Data="{StaticResource FuturisticPlayIcon}" IsVisible="{Binding IsVideo}" Width="18" Height="18"/>
                        </Panel>
                      </Border>
                    </Grid>
                  </Button>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <TextBlock Text="No media has been provided for this tab." IsVisible="{Binding !HasVisibleMedia}" Classes="muted" TextWrapping="Wrap" Margin="4,8,4,16"/>
          </StackPanel>
        </Border>
      </Grid>
    </StackPanel>
  </ScrollViewer>
</UserControl>
