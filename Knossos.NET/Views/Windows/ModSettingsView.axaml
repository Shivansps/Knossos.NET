<KnossosWindow xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="1000" d:DesignHeight="1000"
             x:Class="Knossos.NET.Views.ModSettingsView"
			 xmlns:v="using:Knossos.NET.Views"
			 xmlns:vm="using:Knossos.NET.ViewModels"
			 x:DataType="vm:ModSettingsViewModel"
			 Icon="/Assets/knossos-icon.ico"
			 WindowStartupLocation="CenterOwner"
			 SizeToContent="Width"
			 MinHeight="400"
			 MinWidth="400"
			 WindowHeight="650"
			 Title="{Binding Title}" 
			 CanResize="True">

	<Design.DataContext>
		<vm:ModSettingsViewModel/>
	</Design.DataContext>

	<v:ModLaunchOptionsView/>
</KnossosWindow>
