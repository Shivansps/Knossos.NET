<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="40" d:DesignHeight="40"             
                xmlns:anim="https://github.com/whistyun/AnimatedImage.Avalonia"
             x:Class="Knossos.NET.Views.LoadingIconView"
	         xmlns:v="using:Knossos.NET.Views"
             xmlns:c="using:Knossos.NET.Controls"
	         xmlns:vm="using:Knossos.NET.ViewModels"
	         x:DataType="vm:LoadingIconViewModel">
	
    <Grid>
		<c:AnimatedImage Width="100" ZIndex="0" VerticalAlignment="Center" HorizontalAlignment="Center" Stretch="Uniform" Extension="apng" Playing="{Binding Animate}" Path="avares://Knossos.NET/Assets/general/knossos.apng"/>
    </Grid>
</UserControl>
